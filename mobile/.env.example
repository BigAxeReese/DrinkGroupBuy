# Local configuration only. Never commit a real Google Maps API key.
GOOGLE_MAPS_API_KEY=replace_with_restricted_android_google_maps_api_key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_http_referrer_restricted_web_google_maps_api_key
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000
EXPO_PUBLIC_APP_SCHEME=drinkgroupbuy

# Auth mode for mobile development.
# Production target is Firebase Google Login. Use dev only with backend AUTH_DEV_MODE=true.
EXPO_PUBLIC_AUTH_MODE=firebase
# EXPO_PUBLIC_AUTH_MODE=dev

# Firebase public web/app config for Firebase Auth.
# These values identify the Firebase project; do not put service-account secrets here.
EXPO_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace_with_firebase_project_id
EXPO_PUBLIC_FIREBASE_APP_ID=replace_with_firebase_app_id

# Google OAuth client IDs created for Firebase/Google sign-in.
# Android is required for Android-first testing. Web is useful for Expo Web.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace_with_android_oauth_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace_with_web_oauth_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
